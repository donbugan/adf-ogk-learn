						"value": "@or(\r\n    not(activity('act_get_source_metadata').output.exists),\r\n    or(\r\n        equals(activity('act_get_source_metadata').output?.size, 0),\r\n        not(equals(activity('act_get_source_metadata').output?.columnCount, 17))\r\n    )\r\n)",
