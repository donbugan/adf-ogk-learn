{
	"name": "df_cleanse_fleet_vehicles",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_fleet_vehicles_csv",
						"type": "DatasetReference"
					},
					"name": "srcFleetVehicles"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_fleet_vehicles_curated",
						"type": "DatasetReference"
					},
					"name": "snkFleetVehicles"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Vehicle_ID as string,",
				"          Registration_No as string,",
				"          Vehicle_Category as string,",
				"          Department as string,",
				"          Depot_Location as string,",
				"          Purchase_Date as string,",
				"          Odometer_KM as string,",
				"          Fuel_Type as string,",
				"          Monthly_Fuel_Cost_R as string,",
				"          Maintenance_Cost_YTD_R as string,",
				"          Breakdowns_YTD as string,",
				"          Downtime_Days_YTD as string,",
				"          Last_Service_Date as string,",
				"          Next_Service_Due as string,",
				"          Status as string,",
				"          Driver_Assigned as string,",
				"          Utilization_Hours_Monthly as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcFleetVehicles",
				"srcFleetVehicles filter(!isNull(Vehicle_ID)) ~> filter1",
				"filter1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     partitionFileNames:['vehicles_curated.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> snkFleetVehicles"
			]
		}
	}
}