								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@or(\r\n    not(activity('act_get_source_metadata').output.exists),\r\n    or(\r\n        equals(activity('act_get_source_metadata').output?.size, 0),\r\n        not(equals(activity('act_get_source_metadata').output?.columnCount, 17))\r\n    )\r\n)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "act_fail_invalid_source",
									"type": "Fail",
									"dependsOn": [
										{
											"activity": "act_create_failure_report",
											"dependencyConditions": [
												"Completed"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "Source file @{pipeline().parameters.source_file} failed validation. \nexists=@{activity('act_get_source_metadata').output.exists},\nsize=@{activity('act_get_source_metadata').output?.size}, \ncolumns=@{activity('act_get_source_metadata').output?.columnCount} (expected 17).",
											"type": "Expression"
										},
										"errorCode": "SOURCE_FILE_INVALID"
									}
								},
								{
									"name": "act_create_failure_report",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.00:30:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "PUT",
										"headers": {
											"x-ms-blob-type": "BlockBlob",
											"x-ms-version": "2021-08-06",
											"Content-Type": "application/json"
										},
										"url": {
											"value": "@concat(\n    'https://ogksa.blob.core.windows.net/reports/', \n    pipeline().RunId, \n    '.json')",
											"type": "Expression"
										},
										"body": {
											"value": "{\n  \"source_file\": \"@{pipeline().parameters.source_file}\",\n  \"run_id\": \"@{pipeline().RunId}\",\n  \"run_time_utc\": \"@{utcNow()}\",\n  \"rule\": \"Source file validation\",\n  \"action\": \"Run stopped before load\",\n  \"exists\": \"@{activity('act_get_source_metadata').output.exists}\",\n  \"size\": \"@{activity('act_get_source_metadata').output?.size}\",\n  \"columns\": \"@{activity('act_get_source_metadata').output?.columnCount}\",\n  \"expected_columns\": 17\n}",
											"type": "Expression"
										},
										"authentication": {
											"type": "MSI",
											"resource": "https://storage.azure.com/"
										}
